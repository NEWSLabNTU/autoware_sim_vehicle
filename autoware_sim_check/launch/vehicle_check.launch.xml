<?xml version="1.0" encoding="UTF-8"?>
<!-- vehicle_check (roadmap 051): the car's vehicle description (robot_state_publisher, as
     Autoware's vehicle launch starts it, so a vehicle bridge finds /robot_description and the
     sensor frames) and the check, with no Autoware and no scenario. Start the vehicle side
     beside it: acb_bridge with a hero in CARLA, or aib's runner in Isaac.

       play_launch launch autoware_sim_check vehicle_check.launch.xml simulator:=carla
           [vehicle_model:=tesla_model3] [what:=all|contract|dynamics] [out:=<report.json>] -->
<launch>
  <arg name="vehicle_model" default="tesla_model3"/>
  <arg name="sensor_model" default="$(var vehicle_model)_sensor_kit"/>
  <arg name="simulator" default="any" description="carla | isaac | any: which of the spec's sensors the vehicle side publishes"/>
  <arg name="what" default="all" description="contract | dynamics | all"/>
  <arg name="listen" default="10.0" description="s of simulation time the contract listens"/>
  <arg name="out" default="/tmp/vehicle_check.json"/>

  <set_parameter name="use_sim_time" value="true"/>
  <include file="$(find-pkg-share tier4_vehicle_launch)/launch/vehicle.launch.xml">
    <arg name="use_sim_time" value="true"/>
    <arg name="launch_vehicle_interface" value="false"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
  </include>
  <!-- Required: the launch ends with the check, whatever its verdict (the report says). -->
  <node pkg="autoware_sim_check" exec="vehicle_check" name="vehicle_check" output="screen"
        on_exit="shutdown" args="$(var what) --vehicle-model $(var vehicle_model) --simulator $(var simulator) --listen $(var listen) --out $(var out)"/>
</launch>
