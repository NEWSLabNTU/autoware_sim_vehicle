<?xml version="1.0"?>
<!-- Generated from sim_vehicle_spec/vehicles/newslab_golfcart.yaml (spec_hash 14029812c96707a7c4988bc0e5d8b5402453f4aa155629e30cb41eafb18a2c37) by autoware_gen (autoware_sim_vehicle `just generate`): do not edit; change the spec and regenerate. -->
<robot name="newslab_golfcart_sensor_kit" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- The sensor kit's links, each placed from sensor_kit_calibration.yaml under
       config_dir (Autoware's vehicle launch passes the description's config). -->
  <xacro:arg name="config_dir" default="$(find newslab_golfcart_sensor_kit_description)/config"/>

  <xacro:macro name="sensor_kit_macro" params="parent x y z roll pitch yaw">
    <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"/>
    <joint name="sensor_kit_base_link_joint" type="fixed">
      <origin rpy="${roll} ${pitch} ${yaw}" xyz="${x} ${y} ${z}"/>
      <parent link="${parent}"/>
      <child link="sensor_kit_base_link"/>
    </joint>
    <link name="sensor_kit_base_link"/>

    <!-- vlp32 (lidar) published in velodyne on /sensing/lidar/vlp32/velodyne_points -->
    <joint name="velodyne_joint" type="fixed">
      <origin xyz="${calibration['sensor_kit_base_link']['vlp32c']['x']} ${calibration['sensor_kit_base_link']['vlp32c']['y']} ${calibration['sensor_kit_base_link']['vlp32c']['z']}"
              rpy="${calibration['sensor_kit_base_link']['vlp32c']['roll']} ${calibration['sensor_kit_base_link']['vlp32c']['pitch']} ${calibration['sensor_kit_base_link']['vlp32c']['yaw']}"/>
      <parent link="sensor_kit_base_link"/>
      <child link="velodyne"/>
    </joint>
    <link name="velodyne"/>

    <!-- falcon (lidar) published in seyond on /sensing/lidar/falcon/iv_points -->
    <joint name="seyond_joint" type="fixed">
      <origin xyz="${calibration['sensor_kit_base_link']['falcon']['x']} ${calibration['sensor_kit_base_link']['falcon']['y']} ${calibration['sensor_kit_base_link']['falcon']['z']}"
              rpy="${calibration['sensor_kit_base_link']['falcon']['roll']} ${calibration['sensor_kit_base_link']['falcon']['pitch']} ${calibration['sensor_kit_base_link']['falcon']['yaw']}"/>
      <parent link="sensor_kit_base_link"/>
      <child link="seyond"/>
    </joint>
    <link name="seyond"/>

    <!-- zed (camera) published in zed_left_camera_optical_frame on /sensing/camera/zed/rgb/color/rect/image -->
    <joint name="zed_camera_link_joint" type="fixed">
      <origin xyz="${calibration['sensor_kit_base_link']['zed_camera_link']['x']} ${calibration['sensor_kit_base_link']['zed_camera_link']['y']} ${calibration['sensor_kit_base_link']['zed_camera_link']['z']}"
              rpy="${calibration['sensor_kit_base_link']['zed_camera_link']['roll']} ${calibration['sensor_kit_base_link']['zed_camera_link']['pitch']} ${calibration['sensor_kit_base_link']['zed_camera_link']['yaw']}"/>
      <parent link="sensor_kit_base_link"/>
      <child link="zed_camera_link"/>
    </joint>
    <link name="zed_camera_link"/>
    <joint name="zed_left_camera_optical_frame_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
      <parent link="zed_camera_link"/>
      <child link="zed_left_camera_optical_frame"/>
    </joint>
    <link name="zed_left_camera_optical_frame"/>

    <!-- camera_left (camera) published in camera_left_optical_link on /sensing/camera/left/image_raw -->
    <joint name="camera_left_joint" type="fixed">
      <origin xyz="${calibration['sensor_kit_base_link']['camera_left']['x']} ${calibration['sensor_kit_base_link']['camera_left']['y']} ${calibration['sensor_kit_base_link']['camera_left']['z']}"
              rpy="${calibration['sensor_kit_base_link']['camera_left']['roll']} ${calibration['sensor_kit_base_link']['camera_left']['pitch']} ${calibration['sensor_kit_base_link']['camera_left']['yaw']}"/>
      <parent link="sensor_kit_base_link"/>
      <child link="camera_left"/>
    </joint>
    <link name="camera_left"/>
    <joint name="camera_left_optical_link_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
      <parent link="camera_left"/>
      <child link="camera_left_optical_link"/>
    </joint>
    <link name="camera_left_optical_link"/>

    <!-- camera_right (camera) published in camera_right_optical_link on /sensing/camera/right/image_raw -->
    <joint name="camera_right_joint" type="fixed">
      <origin xyz="${calibration['sensor_kit_base_link']['camera_right']['x']} ${calibration['sensor_kit_base_link']['camera_right']['y']} ${calibration['sensor_kit_base_link']['camera_right']['z']}"
              rpy="${calibration['sensor_kit_base_link']['camera_right']['roll']} ${calibration['sensor_kit_base_link']['camera_right']['pitch']} ${calibration['sensor_kit_base_link']['camera_right']['yaw']}"/>
      <parent link="sensor_kit_base_link"/>
      <child link="camera_right"/>
    </joint>
    <link name="camera_right"/>
    <joint name="camera_right_optical_link_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
      <parent link="camera_right"/>
      <child link="camera_right_optical_link"/>
    </joint>
    <link name="camera_right_optical_link"/>

    <!-- camera_rear (camera) published in camera_rear_optical_link on /sensing/camera/rear/image_raw -->
    <joint name="camera_rear_joint" type="fixed">
      <origin xyz="${calibration['sensor_kit_base_link']['camera_rear']['x']} ${calibration['sensor_kit_base_link']['camera_rear']['y']} ${calibration['sensor_kit_base_link']['camera_rear']['z']}"
              rpy="${calibration['sensor_kit_base_link']['camera_rear']['roll']} ${calibration['sensor_kit_base_link']['camera_rear']['pitch']} ${calibration['sensor_kit_base_link']['camera_rear']['yaw']}"/>
      <parent link="sensor_kit_base_link"/>
      <child link="camera_rear"/>
    </joint>
    <link name="camera_rear"/>
    <joint name="camera_rear_optical_link_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
      <parent link="camera_rear"/>
      <child link="camera_rear_optical_link"/>
    </joint>
    <link name="camera_rear_optical_link"/>

    <!-- imu (imu) published in imu_link on /sensing/imu/xsens/imu_raw -->
    <joint name="imu_link_joint" type="fixed">
      <origin xyz="${calibration['sensor_kit_base_link']['imu_link']['x']} ${calibration['sensor_kit_base_link']['imu_link']['y']} ${calibration['sensor_kit_base_link']['imu_link']['z']}"
              rpy="${calibration['sensor_kit_base_link']['imu_link']['roll']} ${calibration['sensor_kit_base_link']['imu_link']['pitch']} ${calibration['sensor_kit_base_link']['imu_link']['yaw']}"/>
      <parent link="sensor_kit_base_link"/>
      <child link="imu_link"/>
    </joint>
    <link name="imu_link"/>

    <!-- gnss (gnss) published in gnss_base_link on /sensing/gnss/ublox/nav_sat_fix -->
    <joint name="gnss_base_link_joint" type="fixed">
      <origin xyz="${calibration['sensor_kit_base_link']['gnss_base_link']['x']} ${calibration['sensor_kit_base_link']['gnss_base_link']['y']} ${calibration['sensor_kit_base_link']['gnss_base_link']['z']}"
              rpy="${calibration['sensor_kit_base_link']['gnss_base_link']['roll']} ${calibration['sensor_kit_base_link']['gnss_base_link']['pitch']} ${calibration['sensor_kit_base_link']['gnss_base_link']['yaw']}"/>
      <parent link="sensor_kit_base_link"/>
      <child link="gnss_base_link"/>
    </joint>
    <link name="gnss_base_link"/>
  </xacro:macro>
</robot>
