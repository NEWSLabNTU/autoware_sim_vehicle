<launch>
  <!--
    Simulated LiDAR Launch

    This launch file configures the LiDAR processing pipeline for a simulated car.
    Unlike hardware sensor kits, no velodyne drivers are needed since the vehicle bridge
    publishes point cloud data directly to ROS topics.

    The vehicle bridge publishes to /sensing/lidar/top/pointcloud_before_sync (the spec's lidar topic),
    which is consumed by the pointcloud_preprocessor concatenation node.

    Note - the car has a single top LiDAR (its vehicle spec).
  -->

  <arg name="use_concat_filter" default="true"/>
  <arg name="vehicle_mirror_param_file"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="use_distortion_corrector" default="false"/>

  <group>
    <push-ros-namespace namespace="lidar"/>

    <!--
      No velodyne driver includes needed - the vehicle bridge publishes directly.
      The vehicle bridge publishes to /sensing/lidar/top/pointcloud_before_sync (the spec's lidar topic).
    -->

    <!-- Pointcloud concatenation (even with single LiDAR, this is needed for downstream) -->
    <include file="$(find-pkg-share drift_mustang_sensor_kit_launch)/launch/pointcloud_preprocessor.launch.py">
      <arg name="base_frame" value="base_link"/>
      <arg name="use_intra_process" value="true"/>
      <arg name="use_multithread" value="true"/>
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
    </include>
  </group>
</launch>
