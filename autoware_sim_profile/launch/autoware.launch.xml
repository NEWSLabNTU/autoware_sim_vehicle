<?xml version="1.0" encoding="UTF-8"?>
<!-- The Autoware profile for a simulated car (roadmap 051): Autoware 1.5 with the settings a
     simulator needs, and no vehicle interface. A simulator's vehicle bridge includes it and
     starts its own interface beside it: acb_launch carla_simulator.launch.xml on CARLA,
     aib_launch isaac_simulator.launch.xml on Isaac Sim.

     Architecture:
     - Sets use_sim_time globally via set_parameter (fixes ROS 2 parameter propagation issue)
     - Includes autoware.launch.xml with launch_localization=false
     - Includes tier4_localization_component separately with the simulation-tuned NDT parameters
     - Points traffic light recognition at the simulated car's single camera, published as
       camera6 because that is a namespace upstream ships a detector parameter file for
     - Starts no vehicle interface and needs no scenario relay: it is the same with or
       without a scenario runner

     gpu:=N pins the side's CUDA nodes to one card (CUDA_VISIBLE_DEVICES); extra_launch:=<file>
     starts a launch file of your own beside it, in the same domain (scenario-world-bridge's
     vehicle agent is one).
-->
<launch>
  <!-- User's Autoware launch file (can point to a custom fork) -->
  <arg name="autoware_launch"
       default="$(find-pkg-share autoware_launch)/launch/autoware.launch.xml"
       description="Path to user's autoware.launch.xml"/>

  <!-- Essential parameters -->
  <arg name="use_sim_time" default="true" description="use simulation time"/>

  <!-- CRITICAL - Set use_sim_time globally for ALL nodes including localization
       This fixes the parameter propagation issue where localization nodes don't
       inherit use_sim_time from the global_params.launch.py -->
  <set_parameter name="use_sim_time" value="$(var use_sim_time)"/>

  <!-- The GPU this vehicle side's CUDA nodes (TensorRT detectors) run on, as an index or a
       list for CUDA_VISIBLE_DEVICES. Empty inherits the environment's. Several vehicle sides
       on one host pin themselves to different cards with it; CARLA's renderer is chosen by
       Vulkan, not by this. Set before anything is launched, so every node below sees it. -->
  <arg name="gpu" default="" description="CUDA_VISIBLE_DEVICES for this vehicle side; empty = inherit"/>
  <set_env name="CUDA_VISIBLE_DEVICES" value="$(var gpu)"
           if="$(eval '&quot;$(var gpu)&quot; != &quot;&quot;')"/>
  <arg name="map_path" description="point cloud and lanelet2 map directory path"/>

  <!-- The car: its vehicle and sensor kit packages (<vehicle_model>_description, _launch, ...).
       The vehicle bridge that includes this profile names them. -->
  <arg name="vehicle_model" description="vehicle model name"/>
  <arg name="sensor_model" description="sensor model name"/>
  <!-- Upstream's default, and it has to be writable: TensorRT nodes build their engine
       from the ONNX and then write it next to that file. Pointed at the packaged
       /opt/autoware/1.5.0/data, which is root-owned, the build succeeds and the write
       fails, the component constructor throws, and the composable node never loads.
       Silently, too: the rest of the pipeline comes up and just publishes empty
       results. That is what kept traffic light classification off. Populate it once
       with `ros2 run autoware_sim_profile setup_autoware_data`; check_data_path.launch.py
       refuses to launch when it is missing or read-only. -->
  <arg name="data_path" default="$(env HOME)/autoware_data" description="packages data and artifacts directory path; must be writable, populate with: ros2 run autoware_sim_profile setup_autoware_data"/>
  <include file="$(find-pkg-share autoware_sim_profile)/launch/check_data_path.launch.py">
    <arg name="data_path" value="$(var data_path)"/>
  </include>

  <!-- launch module preset -->
  <!-- CARLA preset disables static_obstacle_avoidance module which requires
       lanelet attributes not present in CARLA-converted maps.
       We include the carla preset from our own package (below) to pre-set the
       planning args, then use the upstream "default" preset name so the file
       lookup stays inside autoware_launch (which exists in the Debian install). -->
  <arg name="planning_module_preset" default="default" description="planning module preset"/>
  <arg name="control_module_preset" default="default" description="control module preset"/>

  <!-- Optional parameters -->
  <!-- Modules to be launched -->
  <arg name="vehicle" default="true" description="launch vehicle"/>
  <arg name="system" default="true" description="launch system"/>
  <arg name="map" default="true" description="launch map"/>
  <arg name="sensing" default="true" description="launch sensing"/>
  <arg name="localization" default="true" description="launch localization"/>
  <!-- false: no object recognition (detection, tracking, prediction); the rest of the
       perception component still runs (issue 026). Objects then come from
       publish_ground_truth_objects, which turns recognition off by itself as well. -->
  <arg name="perception" default="true" description="launch object recognition (the rest of perception always runs)"/>
  <arg name="planning" default="true" description="launch planning"/>
  <arg name="control" default="true" description="launch control"/>
  <!-- Map -->
  <arg name="lanelet2_map_file" default="lanelet2_map.osm" description="lanelet2 map file name"/>
  <arg name="pointcloud_map_file" default="pointcloud_map.pcd" description="pointcloud map file name"/>
  <!-- Perception -->
  <!-- Signal state reaches Autoware from CARLA's lights, published by acb_bridge on
       external/traffic_signals (carla-scenario-bridge roadmap 015, after 009 chose V2X over
       vision). true drops the camera branch of traffic light recognition (camera_info
       relay, map-based detector, TensorRT classifier) and keeps multi-camera fusion, the
       arbiter and the crosswalk estimator, so the arbiter only ever sees acb's input. That
       ends its "Published traffic signal messages are not latest" warning (the camera
       path's stamps always lag acb's) and frees the classifier's GPU, CPU and ~45 s start.
       false restores camera-based recognition (009 gap 7). -->
  <arg name="traffic_light_fusion_only" default="true"
       description="skip camera-based traffic light recognition; signals come from the vehicle bridge (V2X)"/>
  <arg name="traffic_light_namespace" default="[traffic_light]" description="traffic light recognition namespace"/>
  <arg name="traffic_light_camera_namespaces" default="[camera6]"
       description="camera namespaces feeding traffic light recognition. Must name a
                    namespace Autoware ships a map-based-detector parameter file for --
                    only camera6 and camera7 exist, and a missing file makes that node
                    exit at startup without failing the launch. acb publishes its one
                    CARLA camera under the TF frame named in acb_bridge's
                    vehicle_config.yaml, which is camera6/camera_link for that reason"/>
  <!-- clustering by default: on CARLA it is the one that passes the AWF standing-pedestrian
       use case. Measured 2026-10-10 on one host and build, UC-AEB-001-0001 (9 variants):
       centerpoint 2/9 (the ego hit the pedestrian in 6, braked at -7.2 m/s^2 in 1; the
       node logged "Fail to preprocess and skip to detect" on TF lookups ~9 s stale),
       clustering 9/9. basic/ and UC-ACC pass with either. It also needs no GPU beside
       CARLA's. centerpoint (TensorRT) remains a choice. -->
  <arg name="lidar_detection_model" default="clustering"
       description="lidar object detection model: clustering (CPU, rule-based; default) or
                    centerpoint (TensorRT)"/>
  <!-- Issue 028. true (Autoware 1.5's default): the multi-channel tracker takes the DNN's
       objects and detection_by_tracker only, so with centerpoint an object CenterPoint has
       not classified (clustering's UNKNOWN) never reaches planning. false: Autoware's lidar
       merger (DNN + clustering, then + detection_by_tracker, lanelet filter) feeds a
       one-channel tracker, as before the multi-channel tracker existed. -->
  <arg name="use_multi_channel_tracker_merger" default="true"
       description="true: multi-channel tracker (DNN + detection_by_tracker); false: the lidar
                    merger (DNN + clustering + detection_by_tracker) into one channel"/>
  <arg name="occupancy_grid_map_method" default="pointcloud_based"
       description="'laserscan_based' avoids the CUDA occupancy grid node"/>
  <!-- Objects from the simulator's ground truth instead of object recognition: the vehicle
       bridge publishes them (acb_bridge's publish_ground_truth_objects), and this turns
       detection, tracking and prediction off (issue 026). -->
  <arg name="publish_ground_truth_objects" default="false"/>
  <!-- A launch file of the user's own to start with this vehicle side, in its ROS domain and
       environment: scenario-world-bridge's vehicle agent, a V2X or cooperative-perception node,
       a recorder. It receives map_path and use_sim_time, and sees every launch argument
       given on the command line; nothing here depends on what it starts. -->
  <arg name="extra_launch" default="" description="path of a launch file to include beside this vehicle side; empty = none"/>
  <!-- Simulation overrides, each switchable (roadmap 017). true: this file launches the
       component with the simulation settings (below). false: the user's autoware.launch.xml
       launches it, unchanged, so a customised component is not replaced. -->
  <arg name="sim_localization" default="true" description="simulation-tuned localization params"/>
  <arg name="sim_perception" default="true" description="selectable lidar model, fusion-only traffic lights"/>
  <arg name="sim_system" default="true" description="simulation component-state topics, MRM params, diagnostic graph"/>
  <!-- MPC's automatic steering offset removal off (issue 025): it learns from collisions
       and transients, never forgets across episodes, so a long-lived stack steered
       differently from a fresh one. Everything else is upstream's control component. -->
  <arg name="sim_control" default="true" description="simulation MPC params (no steering offset learning)"/>
  <arg name="sim_lat_controller_param_path" default="$(find-pkg-share autoware_sim_profile)/config/control/trajectory_follower/lateral/mpc.param.yaml"/>
  <!-- Planning from acb's copy of upstream's component, which takes the common parameter
       file as an argument so max_velocity can reach it; at the default that file is
       upstream's own and the stack is upstream's. -->
  <arg name="sim_planning" default="true" description="planning with a selectable max_velocity"/>
  <!-- Autoware's max_vel (autoware_launch common.param.yaml), the cap on every planner and
       on the external velocity limit a scenario's SpeedAction sets: 4.17 m/s (15 km/h) is
       upstream's, and every suite runs at it. 11.11 (40 km/h) for carla-scenario-bridge's
       demo tour (roadmap 033). Another value loads upstream's file with only max_vel
       changed, written by autoware_sim_profile's planning_common_param. Needs sim_planning. -->
  <arg name="max_velocity" default="4.17" description="Autoware max_vel, m/s; 4.17 (15 km/h) is upstream's"/>
  <!-- Autoware's deprecated (tier4) API, which autoware_launch turns on only for
       scenario_simulation. The vehicle agent needs /api/autoware/set/velocity_limit from it
       (served by autoware_iv_internal_api_adaptor) for a scenario's absolute SpeedAction:
       without it set_speed_limit fails and SSv2 aborts the scenario. Passed to
       autoware.launch.xml, so a user's own autoware.launch.xml gets it too. -->
  <arg name="launch_deprecated_api" default="true" description="tier4 deprecated API (velocity limit for scenarios)"/>
  <!-- System -->
  <arg name="launch_system_monitor" default="false" description="launch system monitor"/>
  <arg name="launch_dummy_diag_publisher" default="false" description="launch dummy diag publisher"/>
  <!-- Sensing -->
  <arg name="launch_sensing_driver" default="false"/>
  <!-- Tools -->
  <arg name="rviz" default="true" description="launch rviz"/>
  <arg name="rviz_config_name" default="autoware.rviz" description="rviz config name"/>
  <arg name="rviz_config" default="$(find-pkg-share autoware_launch)/rviz/$(var rviz_config_name)" description="rviz config path"/>

  <!-- CARLA-optimized localization config path -->
  <arg name="sim_loc_config_path" default="$(find-pkg-share autoware_sim_profile)/config/localization"/>
  <!-- CARLA-optimized system topics config - excludes traffic light topic monitoring -->
  <arg name="sim_system_topics_path" default="$(find-pkg-share autoware_sim_profile)/config/system/component_state_monitor/topics.yaml"/>
  <!-- CARLA-optimized MRM handler config - relaxed timeouts for simulation -->
  <arg name="sim_mrm_handler_path" default="$(find-pkg-share autoware_sim_profile)/config/system/mrm_handler/mrm_handler.param.yaml"/>


  <!-- Pre-set CARLA planning args before autoware.launch.xml includes the
       default_preset.yaml. YAML includes modify the parent context, and child
       contexts inherit configurations, so these values propagate through the
       include chain and take precedence over the default preset's defaults. -->
  <include file="$(find-pkg-share autoware_sim_profile)/config/planning/preset/sim_preset.yaml"/>

  <!-- Include autoware.launch.xml with localization DISABLED
       Localization is launched separately below with CARLA-optimized config -->
  <group scoped="false">
    <include file="$(var autoware_launch)">
      <!-- Common -->
      <arg name="map_path" value="$(var map_path)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
      <arg name="sensor_model" value="$(var sensor_model)"/>
      <arg name="data_path" value="$(var data_path)"/>
      <!-- launch module preset -->
      <arg name="planning_module_preset" value="$(var planning_module_preset)"/>
      <arg name="control_module_preset" value="$(var control_module_preset)"/>
      <!-- Modules to be launched -->
      <arg name="launch_vehicle" value="$(var vehicle)"/>
      <!-- CRITICAL - Disable system here, launch separately with CARLA topics config -->
      <arg name="launch_system" value="$(eval &quot;'$(var system)' == 'true' and '$(var sim_system)' != 'true'&quot;)"/>
      <arg name="launch_map" value="$(var map)"/>
      <arg name="launch_sensing" value="$(var sensing)"/>
      <!-- CRITICAL - Disable localization here, launch separately with CARLA config -->
      <arg name="launch_localization" value="$(eval &quot;'$(var localization)' == 'true' and '$(var sim_localization)' != 'true'&quot;)"/>
      <!-- CRITICAL - Disable perception here, launch separately below so
           lidar_detection_model can be chosen (autoware.launch.xml does not
           forward it, hardwiring centerpoint) -->
      <arg name="launch_perception" value="$(eval &quot;'$(var perception)' == 'true' and '$(var sim_perception)' != 'true'&quot;)"/>
      <!-- CRITICAL - Disable planning here, launch separately below with max_velocity -->
      <arg name="launch_planning" value="$(eval &quot;'$(var planning)' == 'true' and '$(var sim_planning)' != 'true'&quot;)"/>
      <!-- CRITICAL - Disable control here, launch separately below with CARLA MPC params -->
      <arg name="launch_control" value="$(eval &quot;'$(var control)' == 'true' and '$(var sim_control)' != 'true'&quot;)"/>
      <!-- Global parameters -->
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <!-- CRITICAL - Set logging_simulation mode to disable stop_check in pose_initializer -->
      <arg name="system_run_mode" value="logging_simulation"/>
      <!-- Vehicle -->
      <arg name="launch_vehicle_interface" value="false"/>
      <!-- Map -->
      <arg name="lanelet2_map_file" value="$(var lanelet2_map_file)"/>
      <arg name="pointcloud_map_file" value="$(var pointcloud_map_file)"/>
      <!-- System -->
      <arg name="launch_system_monitor" value="$(var launch_system_monitor)"/>
      <arg name="launch_dummy_diag_publisher" value="$(var launch_dummy_diag_publisher)"/>
      <!-- Sensing -->
      <arg name="launch_sensing_driver" value="$(var launch_sensing_driver)"/>
      <!-- Perception -->
      <!-- CARLA - Use high accuracy detection disabled for traffic lights -->
      <!-- Off, and it was worth trying on. With it off, detection/rois is the map
           projection padded by traffic_light_map_based_detector's vibration margins:
           +-0.25 m plus a depth-scaled yaw term, sized for a real vehicle's mount
           against a ~1 m signal head. CARLA's head is 0.451 m wide, so the region comes
           out 3.3x the head at 30 m and 6x at 100 m, and the classifier, which resizes
           exactly that region to 224x224, spends most of its input on whatever is
           behind the signal. The fine detector exists to find the real box inside that
           padding, so turning it on is the obvious fix.

           It is worse. With it on, detection/rois becomes the fine detector's refined
           output and that node does not stay up, so the topic went from 529 non-empty
           messages in a run to zero and the chain produced nothing at all. Leave this
           off until the fine detector's own lifetime is understood. -->
      <arg name="traffic_light_recognition/use_high_accuracy_detection" value="false"/>
      <!-- API -->
      <arg name="launch_deprecated_api" value="$(var launch_deprecated_api)"/>
      <!-- Tools -->
      <arg name="rviz" value="$(var rviz)"/>
      <arg name="rviz_config" value="$(var rviz_config)"/>
    </include>
  </group>

  <!-- Include perception directly (autoware.launch.xml launches it with
       launch_perception=false above) so lidar_detection_model is selectable.
       The high-accuracy traffic light detector stays off, as it was when
       autoware.launch.xml launched perception. -->
  <!-- Launched whether or not `perception` is: with perception:=false (or
       publish_ground_truth_objects:=true) only object recognition (detection, tracking,
       prediction) is left out, and acb's ground truth publishes objects in its place.
       Obstacle segmentation, the occupancy grid and traffic light fusion still run:
       behavior_path_planner waits for the occupancy grid, the planners and AEB read the
       obstacle pointcloud, the diagnostic graph's /autoware/perception checks it, and acb's
       V2X signals reach planning only through fusion and the arbiter. Without them the
       stack never left PLANNING (issue 026). -->
  <group if="$(eval &quot;'$(var sim_perception)' == 'true'&quot;)">
    <!-- The vibration margins are left at upstream's defaults, and it is worth knowing
         why, because shrinking them is the obvious idea and it is wrong.

         traffic_light_map_based_detector pads each projected signal by
         sin(max_vibration_yaw/2) * depth + max_vibration_width/2 per side. Against
         CARLA's 0.451 m head that padding dominates (3.3x the head at 30 m), so the
         classifier spends most of its 224x224 input on scenery, and cutting the margins
         to 0.001 rad / 0.05 m looks like free accuracy.

         Measured, it destroys recognition outright: 534 regions in a run produced ZERO
         non-empty classifier outputs, against 516 with the defaults. The reason is that
         the padding is load-bearing. A 0.451 m head subtends about 13 px at 30 m and
         4 px at 100 m, so with the margins gone the region collapses to the head's true
         size, and there is nothing left to classify: 4x7 px crops were captured.
         The margin is what makes the crop big enough to be worth resizing.

         If this is revisited, the lever is the head's apparent size (a longer focal
         length, or a scenario that gets closer), not the padding. -->
    <!-- autoware_sim_profile's copy of autoware_launch's component (scripts/sync_perception_component.sh;
         run it with check after an Autoware upgrade): identical except that
         traffic_light_recognition/fusion_only is an argument, which upstream hard-codes. -->
    <include file="$(find-pkg-share autoware_sim_profile)/launch/components/tier4_perception_component.launch.xml">
      <arg name="object_recognition" value="$(eval &quot;'$(var perception)' == 'true' and '$(var publish_ground_truth_objects)' != 'true'&quot;)"/>
      <arg name="traffic_light_recognition/fusion_only" value="$(var traffic_light_fusion_only)"/>
      <arg name="data_path" value="$(var data_path)"/>
      <arg name="pointcloud_container_name" value="pointcloud_container"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
      <arg name="lidar_detection_model" value="$(var lidar_detection_model)"/>
      <arg name="occupancy_grid_map_method" value="$(var occupancy_grid_map_method)"/>
      <arg name="use_multi_channel_tracker_merger" value="$(var use_multi_channel_tracker_merger)"/>
      <!-- The component reads $(var perception_mode) without declaring it; when
           autoware.launch.xml includes it the parent's declaration leaks in. -->
      <arg name="perception_mode" value="lidar"/>
      <!-- Off, and it was worth trying on. With it off, detection/rois is the map
           projection padded by traffic_light_map_based_detector's vibration margins:
           +-0.25 m plus a depth-scaled yaw term, sized for a real vehicle's mount
           against a ~1 m signal head. CARLA's head is 0.451 m wide, so the region comes
           out 3.3x the head at 30 m and 6x at 100 m, and the classifier, which resizes
           exactly that region to 224x224, spends most of its input on whatever is
           behind the signal. The fine detector exists to find the real box inside that
           padding, so turning it on is the obvious fix.

           It is worse. With it on, detection/rois becomes the fine detector's refined
           output and that node does not stay up, so the topic went from 529 non-empty
           messages in a run to zero and the chain produced nothing at all. Leave this
           off until the fine detector's own lifetime is understood. -->
      <arg name="traffic_light_recognition/use_high_accuracy_detection" value="false"/>
      <!-- Upstream defaults to both of its sensor kit's traffic light cameras. acb
           spawns one, so the second half of the pipeline ran on topics nothing was
           publishing. -->
      <arg name="traffic_light_recognition/camera_namespaces" value="$(var traffic_light_camera_namespaces)"/>
    </include>
  </group>

  <!-- Include control with CARLA MPC params: autoware_sim_profile's copy of autoware_launch's
       component (scripts/sync_control_component.sh; run it with check after an Autoware
       upgrade), identical except that the lateral parameter file is an argument. -->
  <group if="$(eval &quot;'$(var control)' == 'true' and '$(var sim_control)' == 'true'&quot;)">
    <include file="$(find-pkg-share autoware_sim_profile)/launch/components/tier4_control_component.launch.xml">
      <arg name="module_preset" value="$(var control_module_preset)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
      <arg name="lat_controller_param_path" value="$(var sim_lat_controller_param_path)"/>
      <!-- Declared by autoware.launch.xml, which includes the component upstream -->
      <arg name="vehicle_id" value="$(env VEHICLE_ID default)"/>
      <arg name="check_external_emergency_heartbeat" value="false"/>
    </include>
  </group>

  <!-- Include planning with max_velocity: autoware_sim_profile's copy of autoware_launch's component
       (scripts/sync_planning_component.sh; run it with check after an Autoware upgrade),
       identical except that the common parameter file is an argument. Arguments as
       autoware.launch.xml passes them; the two it takes from its own defaults are written
       out. The trajectory relay is the one autoware.launch.xml starts beside planning. -->
  <group if="$(eval &quot;'$(var planning)' == 'true' and '$(var sim_planning)' == 'true'&quot;)">
    <include file="$(find-pkg-share autoware_sim_profile)/launch/components/tier4_planning_component.launch.xml">
      <arg name="module_preset" value="$(var planning_module_preset)"/>
      <arg name="enable_all_modules_auto_mode" value="false"/>
      <arg name="is_simulation" value="false"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
      <arg name="planning_common_param_path"
           value="$(command '$(find-pkg-prefix autoware_sim_profile)/lib/autoware_sim_profile/planning_common_param $(find-pkg-share autoware_launch)/config/planning/scenario_planning/common/common.param.yaml $(var max_velocity)')"/>
    </include>
    <node pkg="topic_tools" exec="relay" name="trajectory_relay">
      <param name="input_topic" value="/planning/trajectory"/>
      <param name="output_topic" value="/planning/scenario_planning/trajectory"/>
    </node>
  </group>

  <!-- Include localization with CARLA-optimized config
       This uses autoware_sim_profile/config/localization with lowered NDT threshold -->
  <group if="$(eval &quot;'$(var localization)' == 'true' and '$(var sim_localization)' == 'true'&quot;)">
    <include file="$(find-pkg-share autoware_launch)/launch/components/tier4_localization_component.launch.xml">
      <!-- Use CARLA-optimized localization config path -->
      <arg name="loc_config_path" value="$(var sim_loc_config_path)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
      <!-- Required by tier4_localization_component but not declared with a default -->
      <arg name="system_run_mode" value="logging_simulation"/>
    </include>
  </group>

  <!-- Include system with CARLA-optimized topics config
       This uses autoware_sim_profile topics.yaml which excludes traffic light monitoring -->
  <group if="$(eval &quot;'$(var system)' == 'true' and '$(var sim_system)' == 'true'&quot;)">
    <include file="$(find-pkg-share tier4_system_launch)/launch/system.launch.xml">
      <arg name="run_mode" value="logging_simulation"/>
      <arg name="launch_system_monitor" value="$(var launch_system_monitor)"/>
      <arg name="launch_dummy_diag_publisher" value="$(var launch_dummy_diag_publisher)"/>
      <arg name="sensor_model" value="$(var sensor_model)"/>
      <!-- CRITICAL - Use CARLA-specific topics config that excludes traffic light topic -->
      <arg name="component_state_monitor_topic_path" value="$(var sim_system_topics_path)"/>
      <!-- Use default paths for other configs -->
      <arg name="duplicated_node_checker_param_path" value="$(find-pkg-share autoware_launch)/config/system/duplicated_node_checker/duplicated_node_checker.param.yaml"/>
      <arg name="processing_time_checker_param_path" value="$(find-pkg-share autoware_launch)/config/system/processing_time_checker/processing_time_checker.param.yaml"/>
      <arg name="pipeline_latency_monitor_param_path" value="$(find-pkg-share autoware_launch)/config/system/pipeline_latency_monitor/pipeline_latency_monitor.param.yaml"/>
      <arg name="mrm_comfortable_stop_operator_param_path" value="$(find-pkg-share autoware_launch)/config/system/mrm_comfortable_stop_operator/mrm_comfortable_stop_operator.param.yaml"/>
      <arg name="mrm_emergency_stop_operator_param_path" value="$(find-pkg-share autoware_launch)/config/system/mrm_emergency_stop_operator/mrm_emergency_stop_operator.param.yaml"/>
      <arg name="dummy_diag_publisher_param_path" value="$(find-pkg-share autoware_launch)/config/system/diagnostics/dummy_diag_publisher.param.yaml"/>
      <arg name="system_monitor_cpu_monitor_param_path" value="$(find-pkg-share autoware_launch)/config/system/system_monitor/cpu_monitor.param.yaml"/>
      <arg name="system_monitor_gpu_monitor_param_path" value="$(find-pkg-share autoware_launch)/config/system/system_monitor/gpu_monitor.param.yaml"/>
      <arg name="system_monitor_hdd_monitor_param_path" value="$(find-pkg-share autoware_launch)/config/system/system_monitor/hdd_monitor.param.yaml"/>
      <arg name="system_monitor_mem_monitor_param_path" value="$(find-pkg-share autoware_launch)/config/system/system_monitor/mem_monitor.param.yaml"/>
      <arg name="system_monitor_net_monitor_param_path" value="$(find-pkg-share autoware_launch)/config/system/system_monitor/net_monitor.param.yaml"/>
      <arg name="system_monitor_ntp_monitor_param_path" value="$(find-pkg-share autoware_launch)/config/system/system_monitor/ntp_monitor.param.yaml"/>
      <arg name="system_monitor_process_monitor_param_path" value="$(find-pkg-share autoware_launch)/config/system/system_monitor/process_monitor.param.yaml"/>
      <arg name="system_monitor_voltage_monitor_param_path" value="$(find-pkg-share autoware_launch)/config/system/system_monitor/voltage_monitor.param.yaml"/>
      <!-- CARLA-specific MRM handler config with relaxed timeouts -->
      <arg name="mrm_handler_param_path" value="$(var sim_mrm_handler_path)"/>
      <arg name="diagnostic_graph_aggregator_param_path" value="$(find-pkg-share autoware_diagnostic_graph_aggregator)/config/default.param.yaml"/>
      <!-- Use our CARLA-specific diagnostic graph with corrected node names for Autoware 1.5.0 -->
      <arg name="diagnostic_graph_aggregator_graph_path" value="$(find-pkg-share autoware_sim_profile)/config/system/diagnostics/autoware-sim.yaml"/>
    </include>
  </group>

  <group if="$(eval '&quot;$(var extra_launch)&quot; != &quot;&quot;')">
    <include file="$(var extra_launch)">
      <arg name="map_path" value="$(var map_path)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>
  </group>

</launch>
