<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autoware_sim_profile</name>
  <version>0.1.0</version>
  <description>The Autoware profile for a simulated car: Autoware 1.5.0 or 2.0.0 tuned for simulation, no vehicle interface (roadmap 051)</description>
  <maintainer email="user@example.com">User</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <exec_depend>autoware_launch</exec_depend>
  <!-- clock_guard -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <!-- lane_height_check -->
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <!-- the planning trajectory relay -->
  <exec_depend>topic_tools</exec_depend>
  <!-- No release's own launch packages (tier4_*_launch on 1.5.0, autoware_*_launch on 2.0.0):
       autoware_launch, in both, brings them, and a key only one release has fails rosdep on
       the other (tier4_localization_launch on 2.0.0). -->

  <export>
    <build_type>ament_cmake</build_type>
    <scensim_autoware supported="1.5.0..2.1.0" tested="1.5.0/humble 2.0.0/humble 2.1.0/humble"/>
  </export>
</package>
